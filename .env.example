# Database
DATABASE_URL=postgresql+asyncpg://wpcc:wpcc_secret@localhost:5432/wp_command_center

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Google Analytics (OAuth2)
GA_CLIENT_ID=your-ga-client-id
GA_CLIENT_SECRET=your-ga-client-secret

# Google Search Console
GSC_CLIENT_ID=your-gsc-client-id
GSC_CLIENT_SECRET=your-gsc-client-secret

# WPScan Vulnerability Database
WPSCAN_API_KEY=your-wpscan-api-key

# App
FRONTEND_URL=http://localhost:5173
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Notifications (optional)
# MS Teams webhook (Power Automate Workflows URL) — optional fallback; the
# Settings UI value takes precedence
TEAMS_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password

# Auth & security
# Initial admin — used once when the users table is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
JWT_EXPIRY_HOURS=24
# Fernet key (base64, 32 bytes) for encrypting stored credentials; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set true only for local WordPress dev sites on private addresses
ALLOW_PRIVATE_URLS=false
